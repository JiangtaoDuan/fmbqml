include README.md
include LICENSE.txt
include CITATION.cff

recursive-include tests *.py
recursive-include examples *.py *.csv
graft docs

prune docs/_build
prune examples/output
prune .idea
prune .vscode
prune .pytest_cache
prune .mypy_cache
prune .ruff_cache

global-exclude *.py[cod]
global-exclude */__pycache__/*
global-exclude */.ipynb_checkpoints/*
global-exclude */.idea/* */.vscode/*
global-exclude */.pytest_cache/* */.mypy_cache/* */.ruff_cache/*
