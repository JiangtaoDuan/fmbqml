include README.md
include LICENSE.txt
include CITATION.cff
prune tests
prune examples
prune docs/_build
prune .idea
prune .vscode
prune .pytest_cache
prune .mypy_cache
prune .ruff_cache
global-exclude *.py[cod]
global-exclude */__pycache__/* */.idea/* */.vscode/*
global-exclude */.pytest_cache/* */.mypy_cache/* */.ruff_cache/*

